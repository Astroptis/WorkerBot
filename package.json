{
  "name": "qq-bot-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "setup": "node -e \"require('child_process').execSync('pwsh -File scripts/setup.ps1',{stdio:'inherit'})\"",
    "deploy": "npm run setup && wrangler deploy",
    "db:init": "wrangler d1 execute qq-bot-db --file=./src/db/schema.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}